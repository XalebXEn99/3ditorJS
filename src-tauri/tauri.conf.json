{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3ditorJS",
  "version": "0.1.0",
  "identifier": "com.xalebxen99.3ditorjs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "3ditorJS",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.svg"],
    "targets": "all"
  }
}